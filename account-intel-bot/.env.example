# Slack — Create app at https://api.slack.com/apps
# Bot Token Scopes: commands, chat:write, reactions:read, im:write
# Enable Socket Mode and generate App-Level Token with connections:write
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# Tavily — https://tavily.com
TAVILY_API_KEY=tvly-your-key

# Notion — https://www.notion.so/my-integrations
# Create internal integration, share the target database with it
NOTION_TOKEN=secret_your-integration-token
NOTION_DATABASE_ID=your-database-id

# Optional
INTEL_COOLDOWN_SECONDS=120
